ISO-10303-21;
/* A sphere of radius 2 at the origin, as make_sphere(2) builds it (header,
   product and units as in unit_cube.step). Checked by hand: one vertex
   #15 (2,0,0) on the equator #21 (radius 2 round +Z from +X); the upper
   half #30 walks it forwards, counter-clockwise seen from above, with the
   cap inside it on its left; the lower half #39 walks it backwards,
   counter-clockwise seen from below. Both on the same sphere, normals
   outward. Volume 4/3 pi r^3 = 32 pi / 3, area 4 pi r^2 = 16 pi. */
HEADER;
FILE_DESCRIPTION(('Panosolid body'),'2;1');
FILE_NAME('body.step','',(''),(''),'Panosolid','Panosolid','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('automotive design');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3 = PRODUCT_CONTEXT('',#1,'mechanical');
#4 = PRODUCT('body','body','',(#3));
#5 = PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#6 = PRODUCT_DEFINITION_FORMATION('','',#4);
#7 = PRODUCT_DEFINITION('design','',#6,#5);
#8 = PRODUCT_DEFINITION_SHAPE('','',#7);
#9 = (LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#10 = (NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#11 = (NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#12 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-5),#9,'distance_accuracy_value','Panosolid LINEAR');
#13 = (GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#12)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#9,#10,#11)) REPRESENTATION_CONTEXT('',''));
#14 = CARTESIAN_POINT('',(2.0,0.0,0.0));
#15 = VERTEX_POINT('',#14);
#16 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#17 = DIRECTION('',(0.0,0.0,1.0));
#18 = DIRECTION('',(1.0,0.0,0.0));
#19 = AXIS2_PLACEMENT_3D('',#16,#17,#18);
#20 = CIRCLE('',#19,2.0);
#21 = EDGE_CURVE('',#15,#15,#20,.T.);
#22 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#23 = DIRECTION('',(0.0,0.0,1.0));
#24 = DIRECTION('',(1.0,0.0,0.0));
#25 = AXIS2_PLACEMENT_3D('',#22,#23,#24);
#26 = SPHERICAL_SURFACE('',#25,2.0);
#27 = ORIENTED_EDGE('',*,*,#21,.T.);
#28 = EDGE_LOOP('',(#27));
#29 = FACE_BOUND('',#28,.T.);
#30 = ADVANCED_FACE('',(#29),#26,.T.);
#31 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#32 = DIRECTION('',(0.0,0.0,1.0));
#33 = DIRECTION('',(1.0,0.0,0.0));
#34 = AXIS2_PLACEMENT_3D('',#31,#32,#33);
#35 = SPHERICAL_SURFACE('',#34,2.0);
#36 = ORIENTED_EDGE('',*,*,#21,.F.);
#37 = EDGE_LOOP('',(#36));
#38 = FACE_BOUND('',#37,.T.);
#39 = ADVANCED_FACE('',(#38),#35,.T.);
#40 = CLOSED_SHELL('',(#30,#39));
#41 = MANIFOLD_SOLID_BREP('body',#40);
#42 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#43 = DIRECTION('',(0.0,0.0,1.0));
#44 = DIRECTION('',(1.0,0.0,0.0));
#45 = AXIS2_PLACEMENT_3D('',#42,#43,#44);
#46 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#45,#41),#13);
#47 = SHAPE_DEFINITION_REPRESENTATION(#8,#46);
ENDSEC;
END-ISO-10303-21;
