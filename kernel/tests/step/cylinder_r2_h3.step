ISO-10303-21;
/* A cylinder of radius 2 and height 3 standing on the origin, as
   make_cylinder(2, 3) builds it (header, product and units as in
   unit_cube.step, which explains them). Checked by hand: #15 (2,0,0) and
   #17 (2,0,3), each the one vertex of a full circle (#23 at z = 0, #29 at
   z = 3, both round +Z from +X, radius 2). The bottom cap #38 (normal -Z)
   walks #23 backwards, clockwise seen from above, so counter-clockwise
   from below; the top cap #47 (normal +Z) walks #29 forwards; the side #59
   (radius 2 round +Z, normal outward) walks the bottom circle forwards and
   the top one backwards: seen from outside, with z up, a circle round +Z
   runs left to right, so the side lies to the left of the bottom one
   walked forwards (above it) and of the top one walked back (below it).
   No seam: the side has two loops. Volume pi r^2 h = 12 pi, area
   2 pi r h + 2 pi r^2 = 12 pi + 8 pi = 20 pi. */
HEADER;
FILE_DESCRIPTION(('Panosolid body'),'2;1');
FILE_NAME('body.step','',(''),(''),'Panosolid','Panosolid','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('automotive design');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3 = PRODUCT_CONTEXT('',#1,'mechanical');
#4 = PRODUCT('body','body','',(#3));
#5 = PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#6 = PRODUCT_DEFINITION_FORMATION('','',#4);
#7 = PRODUCT_DEFINITION('design','',#6,#5);
#8 = PRODUCT_DEFINITION_SHAPE('','',#7);
#9 = (LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#10 = (NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#11 = (NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#12 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-5),#9,'distance_accuracy_value','Panosolid LINEAR');
#13 = (GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#12)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#9,#10,#11)) REPRESENTATION_CONTEXT('',''));
#14 = CARTESIAN_POINT('',(2.0,0.0,0.0));
#15 = VERTEX_POINT('',#14);
#16 = CARTESIAN_POINT('',(2.0,0.0,3.0));
#17 = VERTEX_POINT('',#16);
#18 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#19 = DIRECTION('',(0.0,0.0,1.0));
#20 = DIRECTION('',(1.0,0.0,0.0));
#21 = AXIS2_PLACEMENT_3D('',#18,#19,#20);
#22 = CIRCLE('',#21,2.0);
#23 = EDGE_CURVE('',#15,#15,#22,.T.);
#24 = CARTESIAN_POINT('',(0.0,0.0,3.0));
#25 = DIRECTION('',(0.0,0.0,1.0));
#26 = DIRECTION('',(1.0,0.0,0.0));
#27 = AXIS2_PLACEMENT_3D('',#24,#25,#26);
#28 = CIRCLE('',#27,2.0);
#29 = EDGE_CURVE('',#17,#17,#28,.T.);
#30 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#31 = DIRECTION('',(0.0,0.0,-1.0));
#32 = DIRECTION('',(1.0,0.0,0.0));
#33 = AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34 = PLANE('',#33);
#35 = ORIENTED_EDGE('',*,*,#23,.F.);
#36 = EDGE_LOOP('',(#35));
#37 = FACE_BOUND('',#36,.T.);
#38 = ADVANCED_FACE('',(#37),#34,.T.);
#39 = CARTESIAN_POINT('',(0.0,0.0,3.0));
#40 = DIRECTION('',(0.0,0.0,1.0));
#41 = DIRECTION('',(1.0,0.0,0.0));
#42 = AXIS2_PLACEMENT_3D('',#39,#40,#41);
#43 = PLANE('',#42);
#44 = ORIENTED_EDGE('',*,*,#29,.T.);
#45 = EDGE_LOOP('',(#44));
#46 = FACE_BOUND('',#45,.T.);
#47 = ADVANCED_FACE('',(#46),#43,.T.);
#48 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#49 = DIRECTION('',(0.0,0.0,1.0));
#50 = DIRECTION('',(1.0,0.0,0.0));
#51 = AXIS2_PLACEMENT_3D('',#48,#49,#50);
#52 = CYLINDRICAL_SURFACE('',#51,2.0);
#53 = ORIENTED_EDGE('',*,*,#23,.T.);
#54 = EDGE_LOOP('',(#53));
#55 = FACE_BOUND('',#54,.T.);
#56 = ORIENTED_EDGE('',*,*,#29,.F.);
#57 = EDGE_LOOP('',(#56));
#58 = FACE_BOUND('',#57,.T.);
#59 = ADVANCED_FACE('',(#55,#58),#52,.T.);
#60 = CLOSED_SHELL('',(#38,#47,#59));
#61 = MANIFOLD_SOLID_BREP('body',#60);
#62 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#63 = DIRECTION('',(0.0,0.0,1.0));
#64 = DIRECTION('',(1.0,0.0,0.0));
#65 = AXIS2_PLACEMENT_3D('',#62,#63,#64);
#66 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#65,#61),#13);
#67 = SHAPE_DEFINITION_REPRESENTATION(#8,#66);
ENDSEC;
END-ISO-10303-21;
