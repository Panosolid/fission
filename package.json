{
  "name": "fission",
  "private": true,
  "workspaces": [
    "packages/*",
    "workspaces/*",
    "apps/*",
    "training"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run build -w @fission/app",
    "e2e": "npm run e2e -w @fission/app",
    "journeys": "npm run journeys -w @fission/testing -w @fission/training"
  }
}
