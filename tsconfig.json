{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src",
    "workspaces/*/src",
    "apps/*/src"
  ],
  "exclude": [
    "packages/core/src/kernel/wasm",
    "packages/testing/src/node-kernel.ts"
  ]
}
