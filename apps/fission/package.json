{
  "name": "fission-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "kernel": "wasm-pack build ../../kernel --target web --out-dir ../apps/fission/src/kernel --out-name fission_kernel",
